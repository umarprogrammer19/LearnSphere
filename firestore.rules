
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read and write their own profile.
    // Admins can read any user profile for management purposes.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId;
    }

    // Rules for the Bookings collection
    match /bookings/{bookingId} {
      // Allow create if user is authenticated (student creating a booking).
      allow create: if request.auth != null;

      // Allow read if user is the student, the tutor for the booking, or an admin.
      allow read: if request.auth.uid == resource.data.studentId 
                   || request.auth.uid == resource.data.tutorId
                   || isAdmin();

      // Allow update if user is the tutor (to confirm/reject) or an admin.
      allow update: if request.auth.uid == resource.data.tutorId || isAdmin();
      
      // Deletion should be restricted, perhaps only to admins or not at all.
      allow delete: if isAdmin();
    }
    
    // Admins can list all users for the dashboard.
    // Students/Teachers cannot list all users.
    match /users/{userId} {
       allow list: if isAdmin();
    }
  }
}
